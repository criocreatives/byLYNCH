---
layout: null
permalink: /search.json
---
[
{% for post in site.posts %}
  {
    "title": {{ post.title | jsonify }},
    "slug": {{ post.slug | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "date": {{ post.date | date_to_xmlschema | jsonify }},
    "categories": {{ post.categories | jsonify }},
    "tags": {{ post.tags | jsonify }},
    "excerpt": {{ post.content | strip_html | strip_newlines | replace: '&nbsp;', ' ' | truncate: 220 | jsonify }},
    "text": {{ post.content | strip_html | strip_newlines | replace: '&nbsp;', ' ' | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]

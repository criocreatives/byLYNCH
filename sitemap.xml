---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for p in site.pages %}
{% if p.layout and p.url %}
  <url><loc>{{ p.url | absolute_url | xml_escape }}</loc></url>
{% endif %}
{% endfor %}
{% for post in site.posts %}
  <url><loc>{{ post.url | absolute_url | xml_escape }}</loc></url>
{% endfor %}
</urlset>
